{
  "name": "vin-checker",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first vehicle VIN checking platform for authorised agency staff",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "create-admin": "node --disable-warning=ExperimentalWarning scripts/create-admin.js",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js",
    "mock-provider": "node scripts/mock-provider.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\""
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "puppeteer-core": "^25.12.0"
  }
}
