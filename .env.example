# VIN Checker configuration. Copy to .env and adjust.
# This file is read only by the server. Secrets here are never sent to browsers.

# --- Network -------------------------------------------------------------
# 127.0.0.1 = this computer only. Use 0.0.0.0 to serve the agency network.
HOST=127.0.0.1
PORT=3000
# Set true when served over HTTPS (directly or behind a reverse proxy).
COOKIE_SECURE=false
# Set true when running behind a reverse proxy (nginx, IIS ARR) so client IPs are logged correctly.
TRUST_PROXY=false

# --- Storage -------------------------------------------------------------
DATA_DIR=data
DB_FILE=vin-checker.db
# BACKUP_DIR=D:/vin-checker-backups

# --- Sessions ------------------------------------------------------------
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12

# --- Lookups -------------------------------------------------------------
LOOKUP_CONCURRENCY=3
MAX_BATCH_SIZE=500
# true = reject VINs whose check digit (position 9) does not match.
STRICT_CHECK_DIGIT=false

# --- Reports -------------------------------------------------------------
# REPORT_TIMEZONE=Africa/Lagos
REPORT_LOCALE=en-GB

# --- Data providers ------------------------------------------------------
# Ordered list of sources queried for every VIN (in parallel):
#   vin-structure   offline VIN analysis (make from WMI, model year, country) — always safe
#   nhtsa-vpic      NHTSA vPIC decoder (US DOT; official, free, no key; public internet)
#   nhtsa-recalls   NHTSA Recalls API (model-level recalls; official, free; public internet)
#   vinaudit        VinAudit accident/damage/theft/title history (paid; credentials required)
#   http            authorised history provider configured with HISTORY_API_*
#   http:<name>     additional authorised providers configured with HTTP_<NAME>_*
#   sample          development sample data (needs ENABLE_SAMPLE_DATA=true)
# Remove nhtsa-vpic / nhtsa-recalls if agency policy does not allow outbound internet access.
DATA_PROVIDERS=vin-structure,nhtsa-vpic,nhtsa-recalls,vinaudit

# Development sample data. MUST be false for live use.
ENABLE_SAMPLE_DATA=false

# Authorised vehicle-history provider (accidents, damage, theft, ownership).
# Requires an agreement and credentials from the provider. Until configured,
# history is reported as "not checked".
# HISTORY_API_URL=https://provider.example/api/v1/vehicles/{vin}
# HISTORY_API_KEY=
# HISTORY_API_KEY_HEADER=Authorization
# HISTORY_API_KEY_PREFIX=Bearer 
# HISTORY_API_NAME=Authorised vehicle-history provider
# HISTORY_API_TRUST=verified
# HISTORY_API_COVERAGE=specs,accidents,statusRecords,ownership,maintenance
# HISTORY_API_TIMEOUT_MS=15000

# Further providers: add "http:insurer" to DATA_PROVIDERS and set, e.g.
# HTTP_INSURER_URL=https://insurer.example/vin/{vin}
# HTTP_INSURER_KEY=
# HTTP_INSURER_NAME=Insurance claims database
# HTTP_INSURER_COVERAGE=accidents,statusRecords

# VinAudit — NMVTIS-approved accident/damage/theft/title history (USA & Canada).
# Paid account required (vinaudit.com). Credentials can instead be entered by an
# administrator in Administration > Branding and data sources (values here take precedence).
# VINAUDIT_KEY=
# VINAUDIT_USER=
# VINAUDIT_PASS=
# Mode: "test" for VinAudit test VINs; empty = production
# VINAUDIT_MODE=
# Reuse a VIN's report for this many days (avoids repeat charges)
# VINAUDIT_REUSE_DAYS=7
